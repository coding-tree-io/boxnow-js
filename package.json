{
  "name": "boxnow-js",
  "version": "0.0.0",
  "private": true,
  "description": "Unofficial TypeScript client, widget helpers, and Astro integration for BOX NOW.",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "biome ci . && pnpm typecheck",
    "test": "vitest run --passWithNoTests",
    "build": "pnpm typecheck",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "keywords": [
    "boxnow",
    "box-now",
    "locker",
    "astro",
    "typescript"
  ],
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@changesets/cli": "^2.31.0",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
